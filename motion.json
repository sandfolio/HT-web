{
  "$metadata": {
    "_figmaSource": "https://www.figma.com/design/lQojkiG3ZFBmsLu2GIShxm/Score-Design-System"
  },
  "duration": {
    "instant": {
      "$type": "duration",
      "$value": "0ms",
      "$figmaVariable": "motion/duration/instant"
    },
    "fast": {
      "$type": "duration",
      "$value": "150ms",
      "$figmaVariable": "motion/duration/fast"
    },
    "normal": {
      "$type": "duration",
      "$value": "250ms",
      "$figmaVariable": "motion/duration/normal"
    },
    "slow": {
      "$type": "duration",
      "$value": "400ms",
      "$figmaVariable": "motion/duration/slow"
    }
  },
  "easing": {
    "ease-in": {
      "$type": "cubicBezier",
      "$value": [
        0.4,
        0,
        1,
        1
      ],
      "$figmaVariable": "motion/easing/ease-in"
    },
    "ease-out": {
      "$type": "cubicBezier",
      "$value": [
        0,
        0,
        0.2,
        1
      ],
      "$figmaVariable": "motion/easing/ease-out"
    },
    "ease-in-out": {
      "$type": "cubicBezier",
      "$value": [
        0.4,
        0,
        0.2,
        1
      ],
      "$figmaVariable": "motion/easing/ease-in-out"
    },
    "linear": {
      "$type": "cubicBezier",
      "$value": [
        0,
        0,
        1,
        1
      ],
      "$figmaVariable": "motion/easing/linear"
    }
  }
}